(* ============================================================
   Open Workout Language (OWL) — Formal Syntax Grammar
   ============================================================
   Notation: ISO/W3C-style EBNF.
     ::=   is-defined-as
     |     alternation
     ?     zero-or-one
     *     zero-or-more
     +     one-or-more (only used inside token definitions)
     ( )   grouping
     'x'   literal terminal
     UPPER lexical (token) rule

   Source of truth: conformance/programs/*.owl. Every production
   below is backed by at least one example in that directory; see
   spec/semantics/ for what each production compiles to,
   spec/semantics/groups.md for a short list of constructs that are
   proposed but not yet attested (dropset, restpause, explicit
   superset rest-args), and spec/semantics/conditionals.md for the
   `if`/`then`/`else` family's compiled shape and its own open
   questions (a `setDecl` conditional branch).

   `progress` is ordinary code, not a call into a closed set of named
   stdlib schemes — see spec/semantics/progression.md. It reads the
   session log via `<label>.<field>` (only meaningful inside a
   progressBody — see progressDecl below) and writes `state` paths by
   assignment, with its own `if`/`then`/`else`.
   ============================================================ *)


(* ---------------- Lexical grammar ---------------- *)

IDENT        ::= LETTER (LETTER | DIGIT | '_')*
LETTER       ::= 'a'..'z' | 'A'..'Z' | '_'
DIGIT        ::= '0'..'9'
NUMBER       ::= DIGIT+ ('.' DIGIT+)?
STRING       ::= '"' (any char except '"')* '"'
COMMENT      ::= '#' (any char except newline)*        (* discarded by the lexer *)

(* '$' immediately followed by an identifier names an entry in the
   exercise catalog. No whitespace is allowed between '$' and IDENT. *)
CATALOG_NAME ::= '$' IDENT

(* Whitespace (including newlines) and COMMENT are insignificant
   between tokens. ';' is an OPTIONAL item separator throughout the
   grammar — every production that lists items writes the trailing
   ';' as '?' for this reason. Consecutive items may be separated by
   ';', a newline, or both; a ';' is never required, including on
   the last item in a list. *)


(* ---------------- Program structure ---------------- *)

program        ::= topLevelItem*

topLevelItem   ::= ( stateSection
                    | unitsDecl
                    | platesDecl
                    | blockDecl
                    | condTopLevelItem
                    | stmt
                    ) ';'?

(* ---- Global declarations ---- *)

(* "state" and "stats" are accepted synonyms for the same section;
   see spec/semantics/parameters.md. *)
stateSection   ::= ( 'state' | 'stats' ) '=' '{' stateBinding* '}'
stateBinding   ::= dottedPath '=' expr ( '|' fallback )? ';'?

(* A fallback is either an ordinary numeric default (NUMBER, optionally
   with the AMRAP-style '+' marker) or an uppercase sentinel IDENT — e.g.
   `AMW` (Assumed Max Weight) — naming an onboarding value the app must
   collect from the athlete when no history exists yet. See
   spec/semantics/parameters.md § Onboarding. *)
fallback       ::= NUMBER '+'?
                 | sentinel
sentinel       ::= IDENT   (* by convention, ALL_CAPS *)

unitsDecl      ::= 'units' '=' STRING
platesDecl     ::= 'plates' '=' '[' NUMBER ( ',' NUMBER )* ']'

blockDecl      ::= 'block' IDENT '=' '{' blockItem* '}'
blockItem      ::= ( dayDecl | condBlockItem | stmt ) ';'?

dayDecl        ::= 'day' IDENT '=' '{' dayItem* '}'
dayItem        ::= ( exerciseDecl | condDayItem | stmt ) ';'?


(* ---- Exercise declarations ---- *)

exerciseDecl   ::= 'exercise' IDENT '=' CATALOG_NAME '{' exerciseItem* '}'
exerciseItem   ::= ( setDecl | progressDecl | dropsetDecl | condExerciseItem ) ';'?

setDecl        ::= 'set' ( IDENT | '_' ) '=' quantity ( '@' quantity )? dropModifier?

(* `progress` is at most one per exercise (spec/semantics/progression.md
   §2), and is itself a small block of code — assignments to `state`
   paths, guarded by its own `if`/`then`/`else` — rather than a call into
   a named scheme. Each branch is an (unbraced) statement list that runs
   until 'else' or the enclosing '}'; 'else' may itself be a nested
   progressIf ("else if …") or a final statement list. *)
progressDecl   ::= 'progress' '=' progressBody
progressBody   ::= '{' progressStmt* '}'
progressStmt   ::= ( progressAssign | progressIf ) ';'?
progressAssign ::= dottedPath '=' expr
progressIf     ::= 'if' condExpr 'then' ':'? progressStmt*
                    ( 'else' ( progressIf | progressStmt* ) )?

(* A named dropset groups a top set with its drop-sets as one atomic
   unit (see spec/semantics/groups.md §3.8). Only `setDecl`s are valid
   inside — dropsets don't nest, and don't carry their own `progress`
   (the exercise's single `progressDecl` reads any of its member sets'
   logs by qualified label — see dropsetDecl's example). *)
dropsetDecl    ::= 'dropset' IDENT '=' '{' ( setDecl ';'? )* '}'

(* Sugar: `drop(f1, f2, ...)` on a set line desugars into an anonymous
   dropset — the annotated set plus one auto-generated `1+` (to-failure)
   set per factor, each loaded at `factor * <this set>.weight`. Requires
   the set it's attached to have a `@ load`. See groups.md §3.8. *)
dropModifier   ::= 'drop' '(' NUMBER ( ',' NUMBER )* ')'


(* ---- Statements ----
   A statement is anything that can appear in a day/block body once
   declarations are in scope: naming a group expression, sequencing
   a previously-declared name, inserting rest, or repeating a name. *)

stmt           ::= assignStmt
                 | repeatStmt
                 | restStmt
                 | groupExpr
                 | inlineCall
                 | ref

assignStmt     ::= IDENT '=' groupExpr

(* A repeatable is either a bare declared name (§3.7 of groups.md: `N`
   copies of that name's own compiled body) or an inline, anonymous
   statement list (the same repetition, just with nothing declared to
   name) — e.g. `(cardio_rower, rest(2min))*5`. *)
repeatStmt     ::= repeatable '*' NUMBER
repeatable     ::= ref
                 | '(' stmt ( ',' stmt )* ')'

restStmt       ::= 'rest' '(' duration ')'
ref            ::= IDENT


(* ---- Conditionals ----
   `if cond then: A else B` picks between two alternatives of whatever
   item list it appears in — a dayItem (exercise/group selection,
   if-then-else.owl), a blockItem (day selection,
   if-then-else-for-days.owl), or a topLevelItem (block selection,
   if-then-else-for-blocks.owl). `cond` reads `state` (a per-athlete
   value), so — unlike every other construct in this file — a
   conditional is NOT resolved away during structural compilation; both
   branches survive into canonical form and `resolve` picks one. See
   spec/semantics/conditionals.md.

   `condExerciseItem` is the exception: with `progress` now a single
   code block per exercise (see progressDecl above) rather than a
   scheme call, there's no longer an attested reason to wrap two whole
   exerciseItems in a conditional — a `progressIf` inside one `progress`
   block covers that, and a conditional `setDecl`/`dropsetDecl` remains
   unattested (spec/semantics/conditionals.md's open questions). The
   production still parses, for symmetry with the other three levels,
   but the compiler rejects it.

   The same `condExpr` is reused by `progressIf` above. `and`/`or` bind
   left-to-right within their own precedence level, `and` tighter than
   `or`; parenthesize to mix them unambiguously.

   The trailing ':' after 'then' is attested both present
   (if-then-else.owl) and absent (if-then-else-for-progress.owl) — purely
   cosmetic, like the optional ';' item separator. 'else' itself is
   required at these four levels: no attested example omits it
   (`progressIf`, above, is the one place `else` is optional). *)

condExpr       ::= condOr
condOr         ::= condAnd ( 'or' condAnd )*
condAnd        ::= condAtom ( 'and' condAtom )*
condAtom       ::= expr relOp expr
                 | '(' condExpr ')'
relOp          ::= '<' | '>' | '<=' | '>=' | '==' | '!='

condExerciseItem ::= 'if' condExpr 'then' ':'? exerciseItem 'else' exerciseItem
condDayItem      ::= 'if' condExpr 'then' ':'? dayItem      'else' dayItem
condBlockItem    ::= 'if' condExpr 'then' ':'? blockItem    'else' blockItem
condTopLevelItem ::= 'if' condExpr 'then' ':'? topLevelItem 'else' topLevelItem


(* ---- Group expressions ----
   These are the constructs that compile to a Group IR node
   (see spec/semantics/groups.md). A group body is itself a list of statements,
   so groups nest freely (e.g. a superset inside an AMRAP). *)

groupExpr      ::= supersetExpr
                 | cadenceExpr
                 | amrapExpr
                 | forTimeExpr

groupBody      ::= '{' ( stmt ';'? )* '}'

supersetExpr   ::= ( 'superset' | 'circuit' ) '(' supersetArg ( ',' supersetArg )* ')'
supersetArg    ::= ref | restStmt

cadenceExpr    ::= ( NUMBER '*' )? 'emom' '(' duration ')' groupBody

amrapExpr      ::= 'amrap' '(' duration ')' groupBody

forTimeExpr    ::= 'for_time' '{' ( roundsExpr | ( stmt ';'? )* ) '}'
roundsExpr     ::= 'rounds' '[' NUMBER ( ',' NUMBER )* ']' 'as' IDENT groupBody


(* ---- Inline (anonymous) exercise invocation ----
   Shorthand for a single unnamed set, used directly inside a group
   body without a prior `exercise` declaration. *)

inlineCall     ::= CATALOG_NAME '(' quantity ( '@' quantity )? ')'


(* ---------------- Expressions & quantities ---------------- *)

(* `quantity`'s trailing '+' (the AMRAP-style "or more" / "to failure"
   marker) is a different production than the '+' inside `expr` below —
   `quantity` wraps a `term`, not an `expr`, so the two never collide:
   `tm.squat.reps+` is quantity's marker on a bare `term`; `weight + 5`
   is expr's binary addition. *)
quantity       ::= term '+'?

expr           ::= term ( ( '+' | '-' ) term )*
term           ::= factor ( ( '*' | '/' ) factor )*
factor         ::= NUMBER unit?
                 | dottedPath
                 | catalogFieldRef
                 | '(' expr ')'

dottedPath     ::= IDENT ( '.' IDENT )*
catalogFieldRef::= CATALOG_NAME '.' IDENT

(* `dottedPath` is overloaded by design, resolved by the compiler's
   scope lookup rather than by a separate grammar rule — and, uniquely,
   by *where* it appears (inside a `set`'s target/load, vs. inside a
   `progressBody`), not scope lookup alone:

   - Everywhere except inside a `progressBody`: a leading segment naming
     a `state` binding root (e.g. `tm`) makes it a state path
     (`tm.squat.weight`); a leading segment naming an earlier `set`
     label in the same exercise/dropset (e.g. `top`) makes it a local
     set-field reference — the *prescribed* target/load formula
     (`top.weight`, only `.weight` attested — see
     spec/semantics/targets-loads.md §4); a leading segment naming a
     `dropset` (e.g. `ds`) qualifies a label declared inside it.
   - Inside a `progressBody`: a leading segment naming a `set` label in
     the enclosing exercise (bare, or dropset-qualified, e.g.
     `top_set.reps`, `ds.top.weight`) instead reads what was actually
     *logged* for that set this session — a different value from the
     same label's meaning outside a progressBody. A bare `tm.*` path
     still means the current `state` value, unchanged. See
     spec/semantics/progression.md §2.

   It is a compile error for the leading segment to resolve to none of
   these. *)

(* 'm' is deliberately overloaded (minutes vs. meters). It is
   resolved by grammar position, never by the lexer: 'm' inside a
   `duration` is minutes; 'm' inside a `quantity`'s `unit` is
   meters. The two nonterminals never appear in the same slot. *)
unit           ::= 'kg' | 'lb' | 'm' | 'km' | 's' | 'min' | 'h' | 'd'
duration       ::= NUMBER ( 's' | 'm' | 'min' | 'h' | 'd' )
   (* 'm' and 'min' are both accepted spellings for minutes here — the
      same alternate spelling `unit` already offers, for consistency.
      'm' inside `unit`, by contrast, means meters (see the note above);
      the two productions are never used in the same slot. *)
