state = {
    tm.leg_ext.weight = 0.85 * $LegExtension.e1rm | 20
}
units = "kg"
plates = [25, 20, 15, 10, 5, 2.5, 1.25]

block main = {
    day day1 = {
        exercise legext = $LegExtension {
            dropset ds = {
                set top = 12 @ tm.leg_ext.weight
                set _   = 1+ @ 0.8 * top.weight
                set _   = 1+ @ 0.6 * top.weight
            }
            progress = {
                if ds.top.reps >= 15 then
                    tm.leg_ext.weight = tm.leg_ext.weight + 5
            }
        }
        legext;
    }
}
