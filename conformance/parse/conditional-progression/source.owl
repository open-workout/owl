state = {
    tm.squat.weight = 100
}
units = "kg"
plates = [25, 20, 15, 10, 5, 2.5, 1.25]

block main = {
    day day1 = {
        exercise squat = $BarbellBackSquat {
            set top_set = 5 @ tm.squat.weight
            progress = {
                if top_set.reps >= 12 then
                    tm.squat.weight += 5
                else
                    tm.squat.weight += 2.5
            }
        }
        squat;
    }
}
