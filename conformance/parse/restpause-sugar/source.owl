state = {
    tm.curl.weight = 0.85 * $DumbbellCurl.e1rm | 15
}
units = "kg"
plates = [25, 20, 15, 10, 5, 2.5, 1.25]

block main = {
    day day1 = {
        exercise curls = $DumbbellCurl {
            set top = 8 @ tm.curl.weight rest_pause(15s, 2)
            progress = {
                if top.reps >= 10 then
                    tm.curl.weight += 2.5
            }
        }
        curls;
    }
}
