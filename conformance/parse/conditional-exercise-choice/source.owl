state = {
    tm.variable = 10
}
units = "kg"
plates = [25, 20, 15, 10, 5, 2.5, 1.25]

block main = {
    day day1 = {
        exercise squat = $BarbellBackSquat {
            set _ = 5 @ 100kg
        }
        exercise bench = $BarbellBenchPress {
            set _ = 5 @ 60kg
        }

        if tm.variable < 15 then:
            squat;
        else
            bench;
    }
}
