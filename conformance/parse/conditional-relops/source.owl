state = {
    tm.a = 5
    tm.b = 5
    tm.c = 1
}
units = "kg"
plates = [25, 20, 15, 10, 5, 2.5, 1.25]

block main = {
    day day1 = {
        exercise x = $BarbellBackSquat {
            set _ = 5 @ 100kg
        }
        exercise y = $BarbellBenchPress {
            set _ = 5 @ 60kg
        }

        if tm.a <= 5 then: x; else y;
        if tm.b >= 5 then: y; else x;
        if tm.c == 1 then: x; else y;
    }
}
