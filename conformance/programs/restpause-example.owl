state = {
    tm.curl.weight  = 0.85 * $DumbbellCurl.e1rm | 15
    tm.press.weight = 0.85 * $DumbbellShoulderPress.e1rm | 12
}
units = "kg"

block main = {
    day day1 = {
        exercise curls = $DumbbellCurl {
            restpause burnout = {
                set top = 8 @ tm.curl.weight
                set _   = 1+ @ top.weight
                set _   = 1+ @ top.weight
            }
            progress = {
                if burnout.top.reps >= 10 then
                    tm.curl.weight += 2.5
            }
        }
        exercise press = $DumbbellShoulderPress {
            set top = 6 @ tm.press.weight rest_pause(20s, 2)
            progress = {
                if top.reps >= 8 then
                    tm.press.weight += 2.5
            }
        }
        curls;
        press;
    }
}
