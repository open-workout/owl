state = {                       # per-athlete, mutated by progression
	tm.squat.weight = 0.85 * $BarbellBackSquat.e1rm | AMW
	tm.squat.reps = 5

    tm.fsquat.weight = 0.8 * $BarbellFrontSquat.e1rm | AMW
    tm.fsquat.reps = 5
	
	tm.leg_ext.weight = 0.85 * $LegExt.e1rm | AMW
	tm.leg_ext.reps = 10
	
	tm.leg_curl.weight = 0.85 * $LyingLegCurl.e1rm | AMW
	tm.leg_curl.reps = 10
	
	tm.calf_raise.weight = 0.85 * $SeatedCalfRaise.e1rm | AMW
	tm.calf_raise.reps = 10

    tm.bp.weight = 0.8 * $BarbellBenchPress.e1rm | AMW
    tm.bp.reps = 6


}
	
units = "kg";
plates = [25, 20, 15, 10, 5, 2.5, 1.25]

block leader = {
	day SE_lower = {
		exercise squat = $BarbellBackSquat {
			set _ = 10 @ 0.8 * tm.squat.weight;
			set top_set = tm.squat.reps+ @ tm.squat.weight;
			progress = {
				if top_set.reps >= 8 then
					tm.squat.reps = top_set.reps
					tm.squat.weight = top_set.weight
					if tm.squat.reps >= 12 then
						tm.squat.weight += 5
						tm.squat.reps = 8
					else
						tm.squat.reps += 1
			}
		}
		exercise legext = $LegExtension {
			set le0 = tm.leg_ext.reps @ tm.leg_ext.weight
			set le1 = tm.leg_ext.reps+ @ tm.leg_ext.weight
			progress = {
				if le1.reps >= 8 then
					tm.leg_ext.reps = le1.reps
					tm.leg_ext.weight = le1.weight
					if tm.leg_ext.reps >= 15 then
						tm.leg_ext.weight += 5
						tm.leg_ext.reps = 8
					else
						tm.leg_ext.reps += 1
			}
		}
		
		exercise llegcurl = $LyingLegCurl {
			set lc0 = tm.leg_curl.reps @ 0.7 * tm.leg_curl.weight
			set lc1 = tm.leg_curl.reps+ @ tm.leg_curl.weight
			progress = {
				if lc1.reps >= 10 then
					tm.leg_curl.reps = lc1.reps
					tm.leg_curl.weight = lc1.weight
					if tm.leg_curl.reps >= 20 then
						tm.leg_curl.weight += 5
						tm.leg_curl.reps = 10
					else
						tm.leg_curl.reps += 1
			}
		}
		
		exercise calfraise = $SeatedCalfRaise {
			set lc0 = tm.calf_raise.reps @ 0.7 * tm.calf_raise.weight
			set lc1 = tm.calf_raise.reps+ @ tm.calf_raise.weight
			progress = {
				if lc1.reps >= 10 then
					tm.calf_raise.reps = lc1.reps
					tm.calf_raise.weight = lc1.weight
					if tm.calf_raise.reps >= 20 then
						tm.calf_raise.weight += 5
						tm.calf_raise.reps = 10
					else
						tm.calf_raise.reps += 1
			}
		}
		
		squat;
		legext;
		llegcurl;
		calfraise;
		
	}

    day SE_upper = {
        exercise frontSquat = $BarbellFrontSquat {
            set _ = 0.8 * tm.fsquat.reps @ 0.8 * tm.fsquat.weight
            set top_set = tm.fsquat.reps @ tm.fsquat.weight
            progress = {
                if top_set.reps >= 4 then
                    tm.fsquat.reps = top_set.reps
                    tm.fsquat.weight = top_set.weight
                    if tm.fsquat.reps >= 7 then
                        tm.fsquat.weight += 5
                        tm.fsquat.reps = 4
                    else
                        tm.fsquat.reps += 1
            }
        }

        exercise bp = $BarbellBenchPress {
            set _ = 0.8 * tm.bp.reps @ 0.8 * tm.bp.weight
            set top_set = tm.bp.reps @ tm.bp.weight
            progress = {
                if top_set.reps >= 5 then
                    tm.bp.reps = top_set.reps
                    tm.bp.weight = top_set.weight
                    if tm.bp.reps >= 8 then
                        tm.bp.weight += 5
                        tm.bp.reps = 5
                    else
                        tm.bp.reps += 1
            }
        }

        frontSquat;
        bp;
    }
	
	SE_lower;
    rest(1d);
    SE_upper;
    rest(1d);
	
}

block pause = {
    day cardio = {
        exercise cardio_rower = $CardioRowing {
            set _ = 10min
        }

        (cardio_rower, rest(2min))*5
    }

    (cardio, rest(1d))*3
    rest(1d)
}

(leader*5, pause)*5

			