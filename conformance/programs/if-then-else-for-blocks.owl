state = {
    tm.injured = 0
}

units = "kg"
plates = [25, 20, 15, 10, 5, 2.5, 1.25]

block main = {
    day day1 = {
        exercise squat = $BarbellBackSquat {
            set _ = 5 @ 100kg
        }
        squat;
    }
}

block rehab = {
    day day1 = {
        exercise squat = $BarbellBackSquat {
            set _ = 5 @ 40kg
        }
        squat;
    }
}

if tm.injured == 1 then:
    rehab*5;
else
    main*5;
