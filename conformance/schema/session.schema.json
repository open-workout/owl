{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owl-lang.org/conformance/schema/session.schema.json",
  "title": "Conformance fixture: resolved Session",
  "description": "What resolve() (spec/semantics/resolution.md) produces: a Day-shaped document with every Expr replaced by a plain resolved value and every Ref inlined. Mirrors spec/canonical-form.schema.json's `day`, `target`, `load`, `member`, `group` defs but with `expr` replaced by `value` and no `ref` variant in `member`. The one exception is `exerciseDecl.progress`: resolve() does not touch it (it has no session log to interpret it against yet — that's progress()'s job, after this Session is logged), so it carries the *same* unresolved shape as spec/canonical-form.schema.json's `progressionBody` (symbolic `expr`/`dottedPath`, not resolved values).",
  "$ref": "#/$defs/session",

  "$defs": {

    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "enum": ["s", "m", "h", "d"] }
      }
    },

    "target": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {
          "kind": { "const": "reps" }, "value": { "type": "number" }, "plus": { "type": "boolean", "default": false } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "value", "unit"], "properties": {
          "kind": { "const": "distance" }, "value": { "type": "number" }, "unit": { "type": "string", "enum": ["m", "km"] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "value", "unit"], "properties": {
          "kind": { "const": "duration" }, "value": { "type": "number" }, "unit": { "type": "string", "enum": ["s", "m", "h"] } } }
      ]
    },

    "load": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "value", "unit"], "properties": {
          "kind": { "const": "weight" }, "value": { "type": "number" }, "unit": { "type": "string", "enum": ["kg", "lb"] } } }
      ]
    },

    "dottedPath": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" },

    "expr": {
      "description": "Unresolved, same shape as canonical-form.schema.json's `expr` — only ever appears inside `exerciseDecl.progress`, which resolve() passes through untouched.",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {
          "type": { "const": "number" }, "value": { "type": "number" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "path"], "properties": {
          "type": { "const": "path" }, "path": { "$ref": "#/$defs/dottedPath" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "catalog", "field"], "properties": {
          "type": { "const": "catalogField" }, "catalog": { "type": "string" }, "field": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "left", "right"], "properties": {
          "type": { "const": "mul" }, "left": { "$ref": "#/$defs/expr" }, "right": { "$ref": "#/$defs/expr" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "left", "right"], "properties": {
          "type": { "const": "add" }, "left": { "$ref": "#/$defs/expr" }, "right": { "$ref": "#/$defs/expr" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "left", "right"], "properties": {
          "type": { "const": "sub" }, "left": { "$ref": "#/$defs/expr" }, "right": { "$ref": "#/$defs/expr" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "left", "right"], "properties": {
          "type": { "const": "div" }, "left": { "$ref": "#/$defs/expr" }, "right": { "$ref": "#/$defs/expr" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "label", "field"], "properties": {
          "type": { "const": "log" }, "label": { "type": "string" }, "field": { "type": "string" } } }
      ]
    },

    "boolExpr": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "op", "left", "right"], "properties": {
          "type": { "const": "comparison" },
          "op": { "type": "string", "enum": ["<", ">", "<=", ">=", "==", "!="] },
          "left": { "$ref": "#/$defs/expr" }, "right": { "$ref": "#/$defs/expr" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "left", "right"], "properties": {
          "type": { "const": "and" }, "left": { "$ref": "#/$defs/boolExpr" }, "right": { "$ref": "#/$defs/boolExpr" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "left", "right"], "properties": {
          "type": { "const": "or" }, "left": { "$ref": "#/$defs/boolExpr" }, "right": { "$ref": "#/$defs/boolExpr" } } }
      ]
    },

    "assign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "expr"],
      "properties": {
        "type": { "const": "assign" },
        "path": { "$ref": "#/$defs/dottedPath" },
        "expr": { "$ref": "#/$defs/expr" }
      }
    },

    "progressionIf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "cond", "then"],
      "properties": {
        "type": { "const": "if" },
        "cond": { "$ref": "#/$defs/boolExpr" },
        "then": { "type": "array", "items": { "$ref": "#/$defs/progressionStmt" } },
        "else": { "type": "array", "items": { "$ref": "#/$defs/progressionStmt" } }
      }
    },

    "progressionStmt": {
      "oneOf": [
        { "$ref": "#/$defs/assign" },
        { "$ref": "#/$defs/progressionIf" }
      ]
    },

    "progressionBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stmts"],
      "properties": {
        "stmts": { "type": "array", "items": { "$ref": "#/$defs/progressionStmt" } }
      }
    },

    "setRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "exercise", "target"],
      "properties": {
        "type": { "const": "setRef" },
        "label": { "type": "string" },
        "exercise": { "type": "string" },
        "target": { "$ref": "#/$defs/target" },
        "load": { "$ref": "#/$defs/load" }
      }
    },

    "member": {
      "oneOf": [
        { "$ref": "#/$defs/setRef" },
        { "$ref": "#/$defs/group" }
      ]
    },

    "restPolicy": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "single" }, "duration": { "$ref": "#/$defs/duration" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode", "intra", "inter"], "properties": {
          "mode": { "const": "two_level" }, "intra": { "$ref": "#/$defs/duration" }, "inter": { "$ref": "#/$defs/duration" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "ad_lib" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "remainder" } } }
      ]
    },

    "termination": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["mode", "n"], "properties": { "mode": { "const": "count" }, "n": { "type": "integer" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode", "interval", "n"], "properties": {
          "mode": { "const": "emom" }, "interval": { "$ref": "#/$defs/duration" }, "n": { "type": "integer" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode", "cap"], "properties": { "mode": { "const": "time_cap" }, "cap": { "$ref": "#/$defs/duration" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "for_time" } } }
      ]
    },

    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "members", "interleave", "rest", "termination", "atomic"],
      "properties": {
        "type": { "const": "group" },
        "kind": { "type": "string", "enum": ["straight", "superset", "circuit", "dropset", "restpause", "emom", "amrap", "for_time", "rounds"] },
        "members": { "type": "array", "items": { "$ref": "#/$defs/member" } },
        "interleave": { "type": "string", "enum": ["sequential", "round_robin"] },
        "rest": { "$ref": "#/$defs/restPolicy" },
        "termination": { "$ref": "#/$defs/termination" },
        "atomic": { "type": "boolean" }
      }
    },

    "exerciseDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "catalog", "sets", "body"],
      "properties": {
        "name": { "type": "string" },
        "catalog": { "type": "string" },
        "sets": { "type": "array", "items": { "$ref": "#/$defs/setRef" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/namedGroup" } },
        "body": { "$ref": "#/$defs/group" },
        "progress": { "$ref": "#/$defs/progressionBody" }
      }
    },

    "namedGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "group"],
      "properties": {
        "name": { "type": "string" },
        "group": { "$ref": "#/$defs/group" }
      }
    },

    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "body"],
      "properties": {
        "name": { "type": "string" },
        "exercises": { "type": "array", "items": { "$ref": "#/$defs/exerciseDecl" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/namedGroup" } },
        "body": { "$ref": "#/$defs/group" }
      }
    }
  }
}
